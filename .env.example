# Password you type to sign in on each device
APP_PASSWORD=
# Any long random string; signs the sign-in cookie
AUTH_SECRET=
# Set automatically when you connect Upstash Redis in Vercel (Storage tab)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Free key from https://api.data.gov/signup (falls back to DEMO_KEY, ~30 searches/hour)
USDA_API_KEY=
# From https://dev.fitbit.com/apps (Personal app, redirect URL = https://YOUR-APP/api/fitbit/callback)
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
# Any random string; lets Vercel's daily cron sync steps
CRON_SECRET=
